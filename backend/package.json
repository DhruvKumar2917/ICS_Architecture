{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend startup script shortcut",
  "scripts": {
    "setup": "(python -m venv .venv 2>nul || py -m venv .venv) && .venv\\Scripts\\pip install -r requirements.txt",
    "postinstall": "(python -m venv .venv 2>nul || py -m venv .venv) && .venv\\Scripts\\pip install -r requirements.txt",
    "start": ".venv\\Scripts\\python main.py"
  }
}
